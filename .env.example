# ══════════════════════════════════════════════════════════
#  ArgenFlow V5 Pro — Konfigurasi Lengkap
#  Salin file ini: cp .env.example .env
#  Lalu edit nilai sesuai akun dan preferensi Anda.
# ══════════════════════════════════════════════════════════


# ── KREDENSIAL AKUN MT5 EXNESS ────────────────────────────
# (Hanya digunakan di Windows dengan MT5 Terminal)
# Di Linux/Termux, bot otomatis masuk Mode Simulasi.

MT5_LOGIN=12345678          # Nomor akun MT5 Exness Anda
MT5_PASS=password_anda      # Password akun MT5
MT5_SERVER=Exness-MT5Demo   # Nama server (lihat di MT5 > File > Login)
                            # Contoh: Exness-MT5Demo | Exness-MT5Real4

MT5_DEMO=true               # true = akun demo (aman)
                            # false = akun REAL (gunakan dengan hati-hati!)


# ── PORT DASBOR WEB ───────────────────────────────────────

PORT=5000                   # Port dasbor di browser (default: 5000)
                            # Ubah jika port 5000 sudah dipakai


# ── MANAJEMEN RISIKO ──────────────────────────────────────

RISIKO_PCT=1.0              # % saldo yang dirisiko per trade
                            # Contoh: 1.0 = $5 risiko per trade di akun $500
                            # Rekomendasi: 0.5 (konservatif) – 2.0 (agresif)

MAX_RUGI_HARIAN=3.0         # % rugi harian sebelum bot berhenti otomatis
                            # Contoh: 3.0 = bot berhenti jika rugi $15/hari (akun $500)
                            # Rekomendasi: 2.0 – 5.0

MIN_LOT=0.01                # Lot minimum per order (default 0.01 = mikro)
MAX_LOT=0.10                # Lot maksimum per order (batas keamanan)
                            # Naikkan jika saldo > $2000 dan sudah berpengalaman

MAX_SPREAD=30               # Spread maksimum yang diterima (dalam points)
                            # Jika spread > nilai ini, simbol dilewati
                            # EUR/USD normal: 5-15 | saat berita: 50-200


# ── TRAILING STOP OTOMATIS ────────────────────────────────

TRAILING_AKTIF=true         # true = trailing stop aktif | false = nonaktif

TRAILING_BE_PCT=50          # % dari jarak TP saat SL digeser ke breakeven
                            # Contoh: 50 = saat profit 50% dari TP → SL ke entry
                            # Akibat: trade tidak bisa rugi setelah ini

TRAILING_KUNCI_PCT=75       # % dari jarak TP saat SL dikunci di 50% profit
                            # Contoh: 75 = saat profit 75% dari TP → kunci 50%
                            # Akibat: profit minimum terjamin meskipun harga berbalik


# ── PARAMETER SL/TP BERBASIS ATR ─────────────────────────

SL_ATR_MULT=1.5             # SL = nilai ini × ATR saat entry
                            # Contoh: ATR=20 pips, SL_ATR_MULT=1.5 → SL=30 pips
                            # Lebih kecil = SL lebih ketat (lebih sering kena stop)
                            # Lebih besar = SL lebih longgar (lebih tahan noise)

TP_ATR_MULT=3.0             # TP = nilai ini × ATR saat entry
                            # Default 3.0 dengan SL 1.5 → R:R = 1:2
                            # Jangan ubah rasio ini sembarangan


# ── PARAMETER INDIKATOR ───────────────────────────────────

PERIODE_RSI=14              # Periode RSI Wilder (standar industri: 14)
PERIODE_EMA=50              # Periode EMA untuk trend filter (M15 + H1)
PERIODE_ATR=14              # Periode ATR untuk kalkulasi SL/TP dinamis

AMBANG_SKOR=80              # Skor minimum untuk membuka trade (0-100)
                            # Lebih tinggi = lebih selektif, sinyal lebih sedikit
                            # Rekomendasi: 70 (lebih banyak sinyal) – 90 (sangat ketat)

RSI_BELI_MAX=32             # RSI di bawah nilai ini = sinyal BELI
                            # Zona oversold: default 32
                            # Lebih ketat: 28 | Lebih longgar: 40

RSI_JUAL_MIN=68             # RSI di atas nilai ini = sinyal JUAL
                            # Zona overbought: default 68
                            # Lebih ketat: 72 | Lebih longgar: 60


# ── OPTIMASI TAMBAHAN ─────────────────────────────────────

ADX_AKTIF=true              # true = aktifkan filter ADX (kekuatan tren)
ADX_MIN=25                  # Nilai ADX minimum untuk entry
                            # < 20 = pasar sideways (banyak false signal)
                            # > 25 = tren mulai terbentuk (aman entry)
                            # > 40 = tren sangat kuat (entry dengan percaya diri)

COOLDOWN_MENIT=30           # Jeda minimum (menit) antar trade di simbol yang sama
                            # Mencegah "revenge trading" setelah loss
                            # Rekomendasi: 15 (aktif) – 60 (sangat sabar)

MAX_TRADE_HARIAN=5          # Jumlah maksimum order yang dibuka per hari
                            # Bot berhenti membuka posisi baru setelah tercapai
                            # Rekomendasi: 3 (konservatif) – 8 (aktif)

FILTER_SENIN=true           # true = skip trading Senin 00:00–09:00 WIB (risiko gap)
FILTER_JUMAT=true           # true = skip trading Jumat 22:00–00:00 WIB (spread melebar)


# ── JAM SESI TRADING ──────────────────────────────────────
# (Hanya berlaku di Mode Nyata — Mode Simulasi aktif 24 jam)

JAM_MULAI_SESI=8            # Jam mulai dalam UTC (08:00 = pembukaan London)
JAM_AKHIR_SESI=17           # Jam akhir dalam UTC (17:00 = penutupan NY)
                            # Rekomendasi: 7-17 (London+NY overlap paling aktif)


# ══════════════════════════════════════════════════════════
#  PRESET PROFIL RISIKO (pilih salah satu, hapus tanda #)
# ══════════════════════════════════════════════════════════

# PROFIL KONSERVATIF (untuk pemula / akun < $300)
# RISIKO_PCT=0.5
# MAX_RUGI_HARIAN=2.0
# SL_ATR_MULT=2.0
# TP_ATR_MULT=4.0
# AMBANG_SKOR=85
# TRAILING_BE_PCT=40

# PROFIL SEIMBANG (default, rekomendasi)
# RISIKO_PCT=1.0
# MAX_RUGI_HARIAN=3.0
# SL_ATR_MULT=1.5
# TP_ATR_MULT=3.0
# AMBANG_SKOR=80
# TRAILING_BE_PCT=50

# PROFIL AGRESIF (untuk trader berpengalaman / akun > $1000)
# RISIKO_PCT=2.0
# MAX_RUGI_HARIAN=5.0
# SL_ATR_MULT=1.2
# TP_ATR_MULT=2.4
# AMBANG_SKOR=75
# TRAILING_BE_PCT=60
